CRM_USERNAME=ayoub
CRM_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters
CRM_DB_PATH=data/reach.sqlite

# MCP and REST bearer token: use at least 32 random characters.
CRM_API_TOKEN=replace-with-a-long-random-integration-token

# Remote libSQL database on Turso. Leave both empty for local development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Set true on Netlify to require durable remote storage.
CRM_REQUIRE_TURSO=false
